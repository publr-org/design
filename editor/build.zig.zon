.{
    .name = .publr_design,
    .version = "0.1.0",
    .fingerprint = 0xf8caebf7551c9142,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Build-time only: the compiler that lowers every module and the jit engine the
        // chrome's classes are compiled with in the browser.
        .pjsx = .{ .path = "../../pjsx" },
        .publr_jit = .{ .path = "../../jit" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "scripts",
        "viewer",
        "dashboard",
    },
}
